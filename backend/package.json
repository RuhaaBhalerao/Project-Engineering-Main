{
  "name": "space-mission-logs-backend",
  "version": "1.0.0",
  "description": "Space Mission Logs API - Performance Engineering Challenge",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:reset": "npx prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "cors": "^2.8.6",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "cross-env": "^10.1.0",
    "prisma": "^5.7.1"
  }
}
